class Main {
    public static void main(String args[]) {
        int[] arr = {1, 2, 3, 6, 43, 22};
        int max=arr[0];
        int second=arr[0];
        for(int i=0;i<arr.length;i++) {
            if (arr[i] > max) {
                second = max;
                max = arr[i];
            } else if (arr[i] > second && arr[i] != max) {
                second = arr[i];
            }
        }
        System.out.println("second largest:"+second);
    }
}
