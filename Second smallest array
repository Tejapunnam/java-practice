class Main {
    public static void main(String args[]) {
        int[] arr = {1, 2, 3, 6, 43, 22};
        int min=arr[0];
        int second=arr[0];
        for(int i=1;i<arr.length;i++) {
            if (arr[i] <min) {
                second = min;
                min = arr[i];
            } else if (arr[i] < second && arr[i] != min) {
                second = arr[i];
            }
        }
        System.out.println("second smallest:"+second);
    }
}
